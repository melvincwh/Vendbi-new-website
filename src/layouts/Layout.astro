---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import AppLinks from '../components/AppLinks.astro';
import Analytics from '../components/Analytics.astro';
interface Props {title:string; description:string; appendBrand?:boolean;}
const {title,description,appendBrand=true}=Astro.props;
const documentTitle=appendBrand ? `${title} | VendBI` : title;
const canonical=new URL(Astro.url.pathname,'https://www.vendbi.com').href;
const nav=[['Platform','/platform/'],['Solutions','/solutions/'],['VBN Network','/vbn-advertising-network/'],['Pricing','/pricing/'],['Resources','/resources/']];
const crumbs=Astro.url.pathname.split('/').filter(Boolean);
const schema=[{'@context':'https://schema.org','@type':'Organization',name:'VendBI',url:'https://www.vendbi.com/',description:'Vending management and business intelligence software.'},...(crumbs.length?[{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://www.vendbi.com/'},...crumbs.map((s,i)=>({'@type':'ListItem',position:i+2,name:s.replaceAll('-',' '),item:'https://www.vendbi.com/'+crumbs.slice(0,i+1).join('/')+'/'}))]}]:[])];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#112a46"/><title>{documentTitle}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href="/favicon.png" type="image/png"/><meta property="og:type" content="website"/><meta property="og:site_name" content="VendBI"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://www.vendbi.com/og-image.png"/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="VendBI — Manage Smarter. Earn Beyond Vending."/><meta name="twitter:card" content="summary_large_image"/><script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g,'\u003c')}/></head>
<body><a class="skip" href="#main">Skip to content</a><div class="announcement">A clearer view of your vending business. <a href="/platform/">Meet VendBI <span aria-hidden="true">↗</span></a></div>
<header class="header"><div class="container header-inner"><Logo/><nav class="desktop-nav" aria-label="Main navigation">{nav.map(([label,href])=><a href={href} aria-current={Astro.url.pathname.startsWith(href)?'page':undefined}>{label}</a>)}</nav><div class="header-actions"><a class="portal" href="https://app.vendbi.com/ops/">Portal Login <span aria-hidden="true">↗</span></a><a class="btn btn-small" href="/book-demo/">Book a Demo <span aria-hidden="true">↗</span></a></div><details class="mobile-nav"><summary aria-label="Open mobile navigation">Menu <span aria-hidden="true">☰</span></summary><nav aria-label="Mobile navigation">{nav.map(([label,href])=><a href={href}>{label}</a>)}<a class="portal" href="https://app.vendbi.com/ops/">Portal Login ↗</a><a class="btn" href="/book-demo/">Book a Demo ↗</a></nav></details></div></header>
<main id="main"><slot/></main>
<footer><div class="container"><div class="footer-top"><div><Logo light/><p>Manage Smarter.<br/>Earn Beyond Vending.</p><a class="portal portal-light" href="https://app.vendbi.com/ops/">Portal Login ↗</a></div><div><h2>Platform</h2><a href="/platform/">Platform overview</a><a href="/features/">Explore features</a><a href="/how-it-works/">How it works</a><a href="/pricing/">Pricing</a></div><div><h2>Possibilities</h2><a href="/solutions/operators/">For operators</a><a href="/solutions/enterprise/">For enterprises</a><a href="/vbn-advertising-network/">VBN Network</a><a href="/vbn-advertising-network/#partner-form">Partner interest</a></div><div><h2>Company</h2><a href="/about/">About VendBI</a><a href="/resources/">Resources</a><a href="/resources/faq/">FAQs</a><a href="/contact/">Contact</a><a href="/book-demo/">Book a Demo</a></div></div><div class="footer-apps"><p>Manage from your phone. Available on Android and iOS.</p><AppLinks/></div><div class="footer-bottom"><span>© {new Date().getFullYear()} VendBI. Vending intelligence.</span><div><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><button id="analytics-settings" type="button" hidden style="background:none;border:0;color:inherit;font:inherit;text-decoration:underline;cursor:pointer;padding:0">Cookie settings</button></div></div><p class="footer-note">VendBI is the software platform. VBN is a distinct advertising network. Vendvision is the wider vending solutions business. Network participation is subject to eligibility and agreed terms.</p></div></footer>
<Analytics/>
</body></html>

---
import Layout from '../../layouts/Layout.astro';import CTA from '../../components/CTA.astro';import {guides} from '../../data/content';
---
<Layout title="Vending management resources and guides" description="Practical guides to vending management, business intelligence and screen advertising participation, plus answers to common VendBI questions."><section class="page-hero"><div class="container"><p class="eyebrow">A LITTLE CLARITY GOES A LONG WAY</p><h1>Useful ideas.<br/>Better questions.</h1><p>Practical starting points for running, understanding and exploring new possibilities for your vending business.</p></div></section><section class="section pt-0"><div class="container"><div class="resource-grid">{guides.map((g,i)=><a class="resource-card" href={'/resources/'+g.slug+'/'}><div class:list={['resource-art',`resource-art-${i}`]}><span>VENDBI / FIELD NOTES</span><strong>{['01','02','03'][i]}</strong></div><div class="resource-content"><p class="eyebrow">{g.category} · GUIDE</p><h2>{g.title}</h2><p>{g.description}</p><span class="text-link">Read the guide ↗</span></div></a>)}</div><div class="resource-faq"><div><h2>Looking for a quick answer?</h2><p>Compatibility, pricing, the customer portal and VBN eligibility.</p></div><a class="btn btn-outline" href="/resources/faq/">Explore FAQs ↗</a></div></div></section><CTA/></Layout>

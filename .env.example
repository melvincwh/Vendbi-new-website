# Local development: PUBLIC_ build variables go in .env; runtime secrets go in .dev.vars. Both ignored.
# Set the same secrets in Cloudflare Pages dashboard for Preview and Production.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
TURNSTILE_SECRET_KEY=
# Public site key, safe for browsers. Rebuild after changing.
PUBLIC_TURNSTILE_SITE_KEY=
# Enable only when legal/privacy/company details have been reviewed. Rebuild to change.
PUBLIC_LEADS_ENABLED=false
